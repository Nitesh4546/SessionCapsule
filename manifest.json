{
  "manifest_version": 3,
  "name": "Session Capsule",
  "version": "1.1.0",
  "description": "Save, organize, and restore your tab sessions directly from the browser sidebar.",
  "permissions": [
    "tabs",
    "storage",
    "sidePanel",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "Open Session Capsule",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "sidebar_action": {
    "default_title": "Session Capsule",
    "default_panel": "sidebar.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidebar.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "sessionCapsule-niteshnunia91@gmail.com",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "120.0"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
